# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Dashboard > Project Settings > Data API / API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Jira Cloud integration ---
# Server-side only: never prefix these with NEXT_PUBLIC_, or they'd be sent to the browser.
# Your Jira site, e.g. https://your-company.atlassian.net (no trailing slash)
JIRA_BASE_URL=
# Email of the Atlassian account that owns the API token. A dedicated service
# account with read access to the relevant Jira projects is best.
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Custom field that stores story points. Varies per site; find it in
# Jira settings > Issues > Custom fields (often customfield_10016).
JIRA_STORY_POINTS_FIELD=customfield_10016

# --- AI story writer (OpenAI-compatible API) ---
# Server-side only. Used by the project's Stories tab to draft Jira stories.
OPENAI_API_KEY=
# Exact model ID from your OpenAI account, e.g. the one listed at https://platform.openai.com/settings (Limits).
OPENAI_MODEL=
# Optional: only if you call the API through a proxy or gateway. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
